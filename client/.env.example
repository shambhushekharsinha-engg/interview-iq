# Firebase API Key used for client-side authentication and storage operations
VITE_FIREBASE_APIKEY=your_firebase_api_key_here

# Razorpay Key ID used to initialize payment checkout forms on the frontend
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Backend API server URL base for client network requests (e.g., http://localhost:8000 in dev)
VITE_SERVER_URL=your_backend_server_url_here
